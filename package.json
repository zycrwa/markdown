{
  "name": "zy-hexo-blog",
  "version": "1.0.0",
  "private": true,
  "description": "A Hexo blog deployed to GitHub Pages",
  "scripts": {
    "build": "npm run check:posts && hexo clean && hexo generate",
    "check:posts": "node scripts/check-posts.js",
    "clean": "hexo clean",
    "deploy": "npm run check:posts && hexo clean && hexo generate && hexo deploy",
    "knowledge:index": "node scripts/build-knowledge-index.js",
    "new": "hexo new",
    "server": "hexo server"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-mathjax": "^0.11.1",
    "hexo-front-matter": "^4.2.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-next": "^8.28.0"
  }
}
